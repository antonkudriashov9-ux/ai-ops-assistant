# Telegram: token from BotFather; /start shows your ID if access is denied.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=[]

# LLM: an OpenAI-compatible endpoint supporting strict JSON Schema outputs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Explicit offline mode. Invalid LLM responses are always blocked.
ENABLE_MOCK_FALLBACK=false

# Resource limits (per running bot instance).
MAX_INPUT_CHARS=12000
MAX_CONCURRENT_ANALYSES=4
USER_COOLDOWN_SECONDS=3

# Local development uses SQLite; Docker Compose overrides DATABASE_URL with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/aiops_audit.db
DATABASE_TIMEOUT_SECONDS=5
ENABLE_SQLITE_FALLBACK=false
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./data/aiops_audit.db

# Required for Docker Compose: choose your own strong password.
# If it contains URL-reserved characters, follow README connection URL guidance.
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=
